{
  "name": "regulatory-radar",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Self-hostable regulatory radar: ingest EU and national regulatory items, translate, group per procedure, classify relevance per country and NACE Rev. 2.1 code.",
  "packageManager": "npm@12.2.3",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=12.2.3"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "e2e"
  ],
  "scripts": {
    "prepare": "husky || true",
    "generate": "npm run generate:server-types && npm run generate:client",
    "generate:server-types": "openapi-typescript openapi/openapi.yaml -o apps/api/src/generated/openapi.ts",
    "generate:client": "openapi-generator-cli generate -i openapi/openapi.yaml -g typescript-angular -o apps/web/src/app/api-client -c openapi/generator-config.yaml",
    "check": "biome check --error-on-warnings .",
    "fix": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "docs:coverage": "npm run docs:coverage --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "audit": "npm audit --audit-level=low",
    "precommit": "npm run check && npm run typecheck && npm run test:unit -w apps/api && npm run test -w apps/web && npm run docs:coverage && npm run audit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@openapitools/openapi-generator-cli": "2.43.0",
    "husky": "9.1.7",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "effect": "3.22.5",
    "archiver-utils": {
      "glob": "14.0.6"
    },
    "i18next": "26.7.2"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.22": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.9": true,
    "msgpackr-extract@3.0.7": true,
    "@openapitools/openapi-generator-cli": false,
    "@scarf/scarf": false,
    "ssh2": false,
    "protobufjs": false,
    "cpu-features": false,
    "fsevents@2.3.3": false
  }
}
