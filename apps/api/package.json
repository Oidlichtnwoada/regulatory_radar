{
  "name": "@radar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "start:api": "node dist/main.js api",
    "start:worker": "node dist/main.js worker",
    "eval": "node dist/main.js eval",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "docs:coverage": "compodoc -p tsconfig.doc.json --silent --coverageTest 100 --coverageMinimumPerFile 100 --coverageTestThresholdFail true -d documentation"
  },
  "dependencies": {
    "@langchain/core": "1.5.0",
    "@langchain/langgraph": "1.7.5",
    "@langchain/mistralai": "1.2.1",
    "@langchain/openai": "1.8.5",
    "@mistralai/mistralai": "3.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "js-tiktoken": "1.0.21",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@compodoc/compodoc": "2.0.0",
    "@nestjs/testing": "12.6.0",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "12.2.2",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "supertest": "7.3.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.1"
  }
}
