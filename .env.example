# Copy to .env (never commit .env). Every value is optional: the default run is offline,
# needs no API key and no network, and streams only the seed file data/items.json.

# --- Mode ---------------------------------------------------------------------------------
# Two modes, each with its own database (radar_offline / radar_online):
#   offline = LLM_PROVIDER=none (or its key missing): no translation, no embeddings,
#             deterministic best-effort grouping and relevance.
#   online  = LLM_PROVIDER=mistral|openai with that provider's API key: translation, embeddings,
#             LangGraph agents. Chat (with tool calling) and multilingual embeddings both come
#             from the ONE selected provider.
# Reference date for "open" / "upcoming" (ISO date). Empty = today (UTC; the services run in Etc/UTC, the UI shows
# times in the browser's time zone).
RADAR_AS_OF=

# --- ML/AI provider (one at a time; programmed against LangChain's chat and embedding interfaces) ---
# none | mistral | openai (with its key, this alone selects the mode)
LLM_PROVIDER=none
# Mistral (La Plateforme). Default: the global endpoint, which has Mistral's built-in web search for the agents
# (no commitment on the processing location). https://api.eu.mistral.ai = EU regional inference (EU/EFTA data
# centres, 10 % surcharge) without web search: agents then only read public pages with fetch_url.
# See https://docs.mistral.ai/inference/regional-inference
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-large-4
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_SERVER_URL=https://api.mistral.ai
# OpenAI (US/global inference). Embedding sizes: mistral-embed 1024, text-embedding-3-large 3072; texts over
# 8192 tokens are compacted once by the chat model before embedding.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_BASE_URL=https://api.openai.com/v1
# Agents may fetch public web pages (fetch_url tool)
AGENT_INTERNET_ACCESS=true
AGENT_MAX_STEPS=12
LLM_CONCURRENCY=3

# --- Pipeline -------------------------------------------------------------------------------
PIPELINE_INTERVAL_SECONDS=15
PIPELINE_BATCH_SIZE=25
# Wait before retrying a failed translation/embedding; each further retry waits 4x longer, 3 attempts max.
PIPELINE_RETRY_SECONDS=300

# --- Sources (each can be enabled/disabled; time filters are optional, inclusive ISO dates) ---
# Seed / file source (no network). Path relative to data/; use items.next.json for the second run.
# false = do not stream data/items.json (e.g. live sources only). Already ingested items stay in the database.
SOURCE_FILE_ENABLED=true
SOURCE_FILE_PATH=items.json
SOURCE_FILE_SINCE=
SOURCE_FILE_POLL_SECONDS=10
# Records per streamed batch (the file streams in file order; the first streamed item names its group)
SOURCE_FILE_BATCH_SIZE=10

# EU: EUR-Lex via the Publications Office CELLAR SPARQL endpoint (network, no key)
SOURCE_EURLEX_ENABLED=false
SOURCE_EURLEX_SINCE=
SOURCE_EURLEX_LOOKBACK_DAYS=14
# Days before the watermark to fetch again each pass (CELLAR indexes some acts days after their document date)
SOURCE_EURLEX_RESCAN_DAYS=7
# CELEX filter: sector 3 regulations/directives/decisions and sector 5 Commission proposals
SOURCE_EURLEX_CELEX_PATTERN=^(3[0-9]{4}[RLD]|5[0-9]{4}PC)
SOURCE_EURLEX_POLL_SECONDS=1800
SOURCE_EURLEX_PAGE_SIZE=200

# National (ES): Boletín Oficial del Estado open-data API (network, no key)
SOURCE_BOE_ENABLED=false
SOURCE_BOE_SINCE=
SOURCE_BOE_LOOKBACK_DAYS=7
# Sections to keep (1 = Disposiciones generales); departments: optional name substrings
SOURCE_BOE_SECTIONS=1
SOURCE_BOE_DEPARTMENTS=
SOURCE_BOE_POLL_SECONDS=3600

SOURCE_HTTP_TIMEOUT_SECONDS=60

# --- Infrastructure -------------------------------------------------------------------------
POSTGRES_PASSWORD=radar
# Host directory of the database (the only state of the application)
POSTGRES_DATA_DIR=./.pgdata
WEB_PORT=8080
# json (default) | text
LOG_FORMAT=json
